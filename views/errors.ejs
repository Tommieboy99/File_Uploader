<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Errors</title>
</head>
<body>
    <% if (errors) { %>
        <div>
            <% errors.forEach((err) => { %>
                <p> <%= err.msg %></p>
            <% }) %>
        </div>
    <% } %>
</body>
</html>