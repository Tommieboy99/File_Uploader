<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Fisto: sign up</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/register.css">
</head>
<body>
  <div class="registerContainer">
    <header class="registerHeader">
      <a href="/" class="homeLink">Home</a>
      <h1>FISTO</h1>
    </header>
    <main class="registerMain">
      <div class="container">
        <h2 class="registerMainTitle">Create your account</h2>
        <% if (locals.errors) { %>
          <div class="backendErrors">
            <div>
              <p> Registration failed: </p>
              <% errors.forEach((error) => { %>
                <p> <%= error.msg %></p>
              <% }) %>
            </div>
            <button class="closeErrorBtn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
              </svg>
            </button>
          </div>
        <% } %>
      </div>
      <form action="/auth/register" method="POST" id="form" class="registerForm" novalidate>
        <div class="inputContainer">
          <label for="email">*Email</label>
          <div class="fieldError" id="emailError"></div>
          <input id="email" type="email" name="email" placeholder="johndoe@example.com" required maxlength="254"/>
        </div>
        
        <div class="inputContainer">
          <label for="password">*Password</label>
          <div class="fieldError" id="passwordError"></div>
          <input id="password" name="password" type="password" required minlength="8" maxlength="128" />
        </div>

        <div class="inputContainer">
          <label for="confirmPassword">*Confirm Password</label>
          <div class="fieldError" id="confirmPasswordError"></div>
          <input id="confirmPassword" name="confirmPassword" type="password" required />
        </div>

        <button type="submit" class="createAccountBtn">Create Account</button>
      </form>

      <p>Have an account? <a href="/auth/login" class="loginLink">Log In</a></p>
    </main>
  </div>

  <script>
    const email = document.getElementById('email');
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');
    const form = document.getElementById('form');

    const emailErrorDiv = document.querySelector('#emailError');
    const passwordErrorDiv = document.querySelector('#passwordError');
    const confirmPasswordErrorDiv = document.querySelector('#confirmPasswordError');

    form.addEventListener('submit', (e) => {

      emailErrorDiv.replaceChildren();
      passwordErrorDiv.replaceChildren();
      confirmPasswordErrorDiv.replaceChildren();

      const emailErrors = [];
      const passwordErrors = [];
      const confirmPasswordErrors = [];

      if (email.validity.valueMissing) {
        emailErrors.push('Email is required');
      }

      if (email.validity.typeMismatch) {
        emailErrors.push('Invalid email')
      }

      if (email.validity.tooLong) {
        emailErrors.push('Email is too long (max. 254 characters)')
      }

      if (password.validity.valueMissing) {
        passwordErrors.push('Password is required');
      }

      if (password.validity.tooShort) {
        passwordErrors.push('Password is too short (min. 8 characters)');
      }

      if (password.validity.tooLong) {
        passwordErrors.push('Password is too long (max. 128 characters)');
      }

      if (password.value !== confirmPassword.value) {
        confirmPasswordErrors.push('Passwords do not match');
      }

      if (confirmPassword.validity.valueMissing) {
        confirmPasswordErrors.push('Confirm password is required')
      }

      if (emailErrors.length > 0 || passwordErrors.length > 0 || confirmPasswordErrors.length > 0) {
        e.preventDefault();
        if (backendErrorsDiv) {
          backendErrorsDiv.classList.add('hidden');
        }
        
        emailErrors.forEach((err) => {
          const p = document.createElement('p');
          p.textContent = err;
          emailErrorDiv.appendChild(p);
        })

        passwordErrors.forEach((err) => {
          const p = document.createElement('p');
          p.textContent = err;
          passwordErrorDiv.appendChild(p);
        })

        confirmPasswordErrors.forEach((err) => {
          const p = document.createElement('p');
          p.textContent = err;
          confirmPasswordErrorDiv.appendChild(p);
        })
      }
    })

    const closeErrorBtn = document.querySelector('.closeErrorBtn');
    const backendErrorsDiv = document.querySelector('.backendErrors');

    if (closeErrorBtn) {
      closeErrorBtn.addEventListener('click', () => {
        backendErrorsDiv.classList.add("hidden");
      })
    }
  </script>
</body>
</html>
