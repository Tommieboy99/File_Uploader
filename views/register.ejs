<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Fisto: sign up</title>
  <link rel="stylesheet" href="/css/register.css">
  <link rel="stylesheet" href="/css/typography.css">
</head>
<body>
  <div class="registerContainer">
    <header class="registerHeader">
      <a href="/" class="homeLink">Home</a>
      <h1>FISTO</h1>
    </header>
    <main class="registerMain">
      <div class="container">
        <h2 class="registerMainTitle">Create your account</h2>
        <% if (locals.errors) { %>
          <div class="backendErrors">
            <div>
              <p> Registration failed: </p>
              <% errors.forEach((error) => { %>
                <p> <%= error.msg %></p>
              <% }) %>
            </div>
            <button class="closeErrorBtn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
              </svg>
            </button>
          </div>
        <% } %>
      </div>
      <form action="/auth/register" method="POST" id="form" novalidate>
        <div class="inputContainer">
          <p class="errorMessage"></p>
          <label for="email">Email</label>
          <input type="email" name="email" placeholder="johndoe@example.com" required/>
        </div>
        
        <div class="inputContainer">
          <p class="errorMessage"></p>
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required minlength="8"/>
        </div>

        <div class="inputContainer">
          <p class="errorMessage"></p>
          <label for="confirmPassword">Confirm Password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" required />
        </div>

        <button type="submit" class="createAccountBtn">Create Account</button>
      </form>

      <p>Have an account? <a href="/auth/login" class="loginLink">Log In</a></p>
    </main>
  </div>

  <script>
    const form = document.getElementById('form');

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const backendErrors = document.querySelector('.backendErrors')
      if (backendErrors) backendErrors.classList.add('hidden')

      form.querySelectorAll(".errorMessage").forEach(el => el.textContent = "");

      const email = form.elements.email
      const password = form.elements.password
      const confirmPassword = form.elements.confirmPassword

      let hasError = false;

      if (!email.checkValidity()) {
        hasError = true;

        if (email.validity.valueMissing) {
          showError(email, 'Email is required')
        } else if (email.validity.typeMismatch) {
          showError(email, 'Invalid email')
        }
      }

      if (!password.checkValidity()) {
        hasError = true;

        if (password.validity.valueMissing) {
          showError(password, 'Password is required');
        } else if (password.validity.tooShort) {
          showError(password, 'Password is too short (min. 8 characters)');
        }
      }

      if (confirmPassword.validity.valueMissing) {
        hasError = true;
        showError(confirmPassword, 'Confirm password is required')
      } else if (password.value !== confirmPassword.value) {
        hasError = true;
        showError(confirmPassword, 'Passwords do not match');
      }

      if (!hasError) {
        form.submit();
      }
    })

    function showError(input, message) {
      const field = input.closest('.inputContainer');
      const errorEl = field.querySelector('.errorMessage');

      errorEl.textContent = message;
    }

    const closeErrorBtn = document.querySelector('.closeErrorBtn');
    const backendErrorsDiv = document.querySelector('.backendErrors');

    if (closeErrorBtn) {
      closeErrorBtn.addEventListener('click', () => {
        backendErrorsDiv.classList.add("hidden");
      })
    }
  </script>
</body>
</html>
