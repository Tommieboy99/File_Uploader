<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Fisto: dashboard</title>
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/typography.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="main">
        <div class="fileSection">
            <h2 class="uploadTitle">Upload</h2>

            <% if (flash.uploadFileErrors) { %>
                <div class="backendErrors">
                    <div class="errorContainer">
                        <p>File upload failed:</p>
                        <% flash.uploadFileErrors.forEach((e) => { %>
                            <p> <%= e.msg %></p>
                        <% }) %>
                    </div>
                    <button class="closeErrorBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
                            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                        </svg>
                    </button>
                </div>
            <% } %> 
            
            <form action="/file/upload" method="post" enctype="multipart/form-data" class="uploadForm" novalidate>

                <div class="uploadContainer">
                    <p class="errorMessage" id="fileError"></p>
                    <div class="inputContainer">
                        <label id="fileLabel">
                            <p id="inputMessage">Click to select a file</p>
                            <input type="file" id="fileInput" name="uploaded_file" required accept="image/*">
                        </label>
                    </div>
                </div>

                <fieldset class="uploadOptions">
                    <legend class="fieldsetLegend">Upload options</legend>
                    <p class="errorMessage" id="optionError"></p>
                    <div class="radioContainer">
                        <label class="radio"><input type="radio" name="uploadOption" value="noFolder" required>No folder</label>
                        <label class="radio"><input type="radio" name="uploadOption" value="newFolder">New folder</label>
                        <% if (folders.length !== 0) { %>
                            <label class="radio"><input type="radio" name="uploadOption" value="selectFolder">Select folder</label>
                        <% } %>
                    </div>
                </fieldset>

                <div class="uploadOptionContent" data-option="newFolder">
                    <p class="errorMessage" id="newFolderError"></p>
                    <input type="text" id="newFolderInput" name="newFolderName" placeholder="folder name" required minlength="1">
                </div>

                <div class="uploadOptionContent" data-option="selectFolder">
                    <p class="errorMessage" id="selectFolderError"></p>
                    <select name="selectedFolder" id="selectFolder" required>
                        <option value="">Click to select folder</option>
                    <% folders.forEach((folder) => { %>
                        <option value="<%= folder.id %>"> <%= folder.name %> </option>
                    <% }) %>
                    </select>
                </div>
                
                <button type="submit" class="uploadBtn">Upload</button>
            </form>
        </div>

        <div class="storageSection">
            <div class="headerContent">
                <div class="storageHeader">
                    <h2 class="storageTitle">Storage</h2>
                    <button type="button" class="createFolderBtn" id="showDialogBtn">Create Folder</button>
                </div>
                <% if (flash.createFolderErrors) { %>
                    <div class="backendErrors">
                        <div class="errorContainer">
                            <p>Folder creation failed:</p>
                            <% flash.createFolderErrors.forEach((e) => { %>
                                <p> <%= e.msg %></p>
                            <% }) %>
                        </div>
                        <button class="closeErrorBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
                                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                            </svg>
                        </button>
                    </div>
                <% } %> 
                <dialog id="createFolderDialog">
                    <button id="closeDialogBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
                            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                        </svg>
                    </button>
                    <form action="/folder/create" method="post" class="createFolderForm" novalidate>
                        <div class="inputContainer">
                            <p class="errorMessage" id="createFolderError"></p>
                            <input type="text" id="createFolderInput" name="folderName" placeholder="folder name" required>
                        </div>
                        <button type="submit" class="createFolderBtn">Create</button>
                    </form>
                </dialog>
            </div>
            <% if (rootFiles.length === 0 && folders.length === 0) { %>
                <p>Your storage is empty.</p>
            <% } else { %>
                <div class="folderOverview">
                <% rootFiles.map((file) => { %>
                    <a href="/file/<%=file.id%>" class="file">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-icon lucide-file">
                            <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/>
                        </svg>
                        <p> <%= file.name %> </p>
                    </a>
                <% }) %>
                <% folders.map((folder) => { %>
                    <a href="/folder/<%=folder.id%>" class="folder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
                        </svg>
                        <%= folder.name %> 
                    </a>
                <% }) %>
            <% } %>
            </div>
        </div>
    </main>
    
    <script>

        const fields = {
            file: {
                input: document.querySelector('#fileInput'),
                error: document.querySelector('#fileError'),
            },
            option: {
                input: document.querySelectorAll('input[name="uploadOption"]'),
                error: document.querySelector('#optionError'),
            },
            newFolder: {
                input: document.querySelector('#newFolderInput'),
                error: document.querySelector('#newFolderError'),
            },
            selectFolder: {
                input: document.querySelector('#selectFolder'),
                error: document.querySelector('#selectFolderError'),
            },
            createFolder: {
                input: document.querySelector('#createFolderInput'),
                error: document.querySelector('#createFolderError')
            }
        }

        const inputMessage = document.querySelector('#inputMessage');

        fields.file.input.addEventListener('change', () => {
            if (fields.file.input.files.length > 0) {
                inputMessage.textContent = `Selected file: ${fields.file.input.files[0].name}` 
            } else {
                inputMessage.textContent = 'Click to select a file'
            }
        })

        function validateForm() {
            let isValid = true;

            // reset errors
            Object.values(fields).forEach(f => {
                if (f.error) f.error.textContent = "";
            });

            // FILE
            if (fields.file.input.validity.valueMissing) {
                fields.file.error.textContent = "File is required";
                isValid = false;
            }

            // RADIO GROUP
            const selectedOption = [...fields.option.input].some(r => r.checked);

            if (!selectedOption) {
                fields.option.error.textContent = "Upload option is required";
                isValid = false;
            }

            const option = document.querySelector('input[name="uploadOption"]:checked')?.value;

            // CONDITIONAL FIELDS
            if (option === "newFolder") {
                if (fields.newFolder.input.validity.valueMissing) {
                    fields.newFolder.error.textContent = "Folder name is required";
                    isValid = false;
                }
            }

            if (option === "selectFolder") {
                if (fields.selectFolder.input.validity.valueMissing) {
                    fields.selectFolder.error.textContent = "Folder selection is required";
                    isValid = false;
                }
            }

            return isValid;
        }

        const uploadForm = document.querySelector(".uploadForm");

        uploadForm.addEventListener('submit', (e) => {
            if (!validateForm()) {
                e.preventDefault();
            }
        })

        function validateFile() {
            if (fields.file.input.validity.valueMissing) {
                fields.file.error.textContent = "File is required";
            } else {
                fields.file.error.textContent = "";
            }
        }

        function validateOption() {
            const selectedOption = [...fields.option.input].some(r => r.checked);

            if (!selectedOption) {
                fields.option.error.textContent = "Upload option is required";
            } else {
                fields.option.error.textContent = "";
            }
        }

        function validateNewFolder() {
            if (fields.newFolder.input.validity.valueMissing) {
                fields.newFolder.error.textContent = "Folder name is required";
            } else {
                fields.newFolder.error.textContent = "";
            }
        }

        function validateSelectFolder() {
            if (fields.selectFolder.input.validity.valueMissing) {
                fields.selectFolder.error.textContent = "Folder selection is required";
            } else {
                fields.selectFolder.error.textContent = "";
            }
        }

        fields.file.input.addEventListener("change", validateFile);
        fields.newFolder.input.addEventListener("input", validateNewFolder);
        fields.selectFolder.input.addEventListener("change", validateSelectFolder)

        
        function handleRadioChange(value) {
            document.querySelectorAll('.uploadOptionContent').forEach(el => {
                const isActive = el.dataset.option === value;

                el.style.display = isActive ? 'flex' : 'none';

                el.querySelectorAll('input, select').forEach(field => {
                    field.disabled = !isActive;
                })
            })
        }

        fields.option.input.forEach(radio => {
            radio.addEventListener("change", (e) => {
                validateOption();
                handleRadioChange(e.target.value);
            })
        })

        const createFolderDialog = document.querySelector('#createFolderDialog');
        const showDialogBtn = document.querySelector('#showDialogBtn')
        const closeDialogBtn = document.querySelector('#closeDialogBtn');
        
        showDialogBtn.addEventListener("click", () => {
            createFolderDialog.showModal();
        })

        closeDialogBtn.addEventListener("click", () => {
            createFolderDialog.close();
        })

        function validateCreateFolder() {
            const { input, error } = fields.createFolder;

            error.textContent = "";

            if (input.validity.valueMissing) {
                error.textContent = "Folder name is required"
                return false;
            }

            return true;
        }

        const createFolderForm = document.querySelector(".createFolderForm");

        createFolderForm.addEventListener('submit', (e) => {

            const isValid = validateCreateFolder();

            if (!isValid) {
                e.preventDefault();
            }
        })

        fields.createFolder.input.addEventListener("input", validateCreateFolder);

        const closeErrorBtn = document.querySelector('.closeErrorBtn');
        const backendErrorsDiv = document.querySelector('.backendErrors');

        if (closeErrorBtn) {
            closeErrorBtn.addEventListener("click", () => {
                backendErrorsDiv.classList.add("hidden");
            })
        }
    </script>
</body>
</html>
