<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Log In</title>
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/typography.css">
</head>
<body>
  <div class="loginContainer">
    <header class="loginHeader">
      <a href="/" class="homeLink">Home</a>
      <h1>FISTO</h1>
    </header>
    <main class="loginMain">
      <% if (flash.success) { %>
        <p class="successMessage"> <%= flash.success %> </p>
      <% } %>

      <h2 class="loginMainTitle">Log into your account</h2>
      
      <% if (flash.error) { %>
        <div class="backendErrors">
          <div class="errorContainer">
            <p>Login failed:</p>
            <p><%= flash.error %></p>
          </div>
          <button class="closeErrorBtn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x">
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>
        </div>
      <% } %>
      
      <form action="/login" method="POST" class="loginForm" novalidate>
        <div class="inputContainer">
          <p class="errorMessage" id="emailError"></p>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required/>
        </div>

        <div class="inputContainer">
          <p class="errorMessage" id="passwordError"></p>
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required/>
        </div>

        <button type="submit" class="loginBtn">Log In</button>
      </form>

      <p>No account? <a href="/register" class="registerLink">Create one</a></p>
    </main>
  </div>

  <script>
    const form = document.querySelector('.loginForm');
    const fields = {
      email: {
        input: document.querySelector('#email'),
        error: document.querySelector("#emailError")
      },
      password: {
        input: document.querySelector('#password'),
        error: document.querySelector('#passwordError')
      }
    }

    const closeErrorBtn = document.querySelector('.closeErrorBtn');
    const backendErrors = document.querySelector('.backendErrors');
    const successMessage = document.querySelector('.successMessage');

    if (closeErrorBtn) {
      closeErrorBtn.addEventListener('click', () => {
        backendErrors.classList.add("hidden");
      })
    }

    function validateEmail() {
      const { input, error } = fields.email;

      input.setCustomValidity("");

      if (input.validity.valueMissing) {
        input.setCustomValidity("Email is required");
      } else if (input.validity.typeMismatch) {
        input.setCustomValidity("Enter a valid email address")
      }

      error.textContent = input.validationMessage;
    }

    function validatePassword() {
      const { input, error} = fields.password;

      input.setCustomValidity("");

      if (input.validity.valueMissing) {
        input.setCustomValidity("Password is required");
      } 

      error.textContent = input.validationMessage;
    }

    form.addEventListener('submit', (e) => {
      validateEmail();
      validatePassword();

      if (!form.checkValidity()) {
        e.preventDefault();
        if (backendErrors) backendErrors.classList.add("hidden");
        if (successMessage) successMessage.classList.add("hidden");
      }
    })

    fields.email.input.addEventListener("blur", validateEmail);
    fields.password.input.addEventListener("blur", validatePassword);
  </script>
</body>
</html>
